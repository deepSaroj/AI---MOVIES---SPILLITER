# Copy to .env and fill in. NEVER commit .env to GitHub.
SECRET_KEY=change-this-to-a-long-random-string
# Production: postgresql://user:password@host:5432/dbname  (blank = local SQLite)
DATABASE_URL=
MAX_UPLOAD_MB=2048
MAX_REMOTE_MB=1024
RETENTION_DAYS=7
REENCODE_DEFAULT=0
SESSION_COOKIE_SECURE=0
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Production queue (optional): JOB_RUNNER=celery + REDIS_URL=redis://localhost:6379/0
JOB_RUNNER=thread
REDIS_URL=
